# Copy this file to .env and fill real values (never commit .env)
# Backend (Spring Boot reads these environment variables)

DB_URL=jdbc:mysql://localhost:3306/handholding_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Gmail App Password (16 digits, not your Gmail password)
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
